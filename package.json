{
  "name": "auto-work",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json && vite build",
    "start": "node scripts/start.mjs",
    "server": "node dist/server/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "desktop": "electron .",
    "build:launcher": "/bin/zsh scripts/build-launcher.sh",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "node-schedule": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/node-schedule": "^2.1.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Codex CLI 本地开发任务排队与调度面板，支持独立 worktree、图片需求、每日定时和 Review 报告",
  "repository": {
    "type": "git",
    "url": "https://github.com/linhengchang/CodexQueue.git"
  },
  "homepage": "https://github.com/linhengchang/CodexQueue#readme",
  "bugs": {
    "url": "https://github.com/linhengchang/CodexQueue/issues"
  },
  "build": {
    "appId": "local.autowork.desktop",
    "productName": "Auto Work",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/preload.cjs",
      "desktop/runtime-data.mjs",
      "dist/**/*",
      "dist-web/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
